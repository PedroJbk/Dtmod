#!/bin/bash

# Cores
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Detectar diretório de instalação
if [ -d "/root/Dtmod" ]; then
    PANEL_DIR="/root/Dtmod"
elif [ -d "$HOME/Dtmod" ]; then
    PANEL_DIR="$HOME/Dtmod"
else
    # Tenta descobrir onde o script real está
    PANEL_DIR="$(dirname "$(readlink -f "$0")")"
    if [ ! -f "$PANEL_DIR/ecosystem.config.js" ]; then
        echo -e "${RED}Erro: Diretório do painel não encontrado!${NC}"
        exit 1
    fi
fi

ENV_FILE="$PANEL_DIR/.env"

show_menu() {
    clear
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}      BEM VINDO AO DTUNNEL MOD         ${NC}"
    echo -e "${GREEN}=======================================${NC}"
    echo ""
    echo -e "${CYAN}1.${NC} Fazer backup"
    echo -e "${CYAN}2.${NC} Restaurar backup"
    echo -e "${CYAN}3.${NC} Reiniciar painel"
    echo -e "${CYAN}4.${NC} Ativar Auto backup"
    echo -e "${CYAN}5.${NC} Remover painel"
    echo -e "${CYAN}6.${NC} Configurar porta do painel ${YELLOW}(Atual: $(grep "^PORT=" "$ENV_FILE" | cut -d'=' -f2 || echo "3000"))${NC}"
    echo -e "${CYAN}0.${NC} Sair"
    echo ""
    echo -n -e "${GREEN}Escolha uma opção: ${NC}"
}

while true; do
    show_menu
    read opt
    case $opt in
        1)
            echo "Fazendo backup..."
            tar -czf "$HOME/dtmod_backup_$(date +%F_%H-%M).tar.gz" "$PANEL_DIR"
            echo -e "${GREEN}Backup concluído em $HOME/dtmod_backup_$(date +%F_%H-%M).tar.gz${NC}"
            sleep 2
            ;;
        2)
            echo "Restaurar backup não implementado ainda."
            sleep 2
            ;;
        3)
            echo "Reiniciando painel..."
            cd "$PANEL_DIR"
            ./pon
            sleep 2
            ;;
        4)
            echo "Auto backup ativado (simulado)."
            sleep 2
            ;;
        5)
            echo -e "${RED}Removendo painel...${NC}"
            pm2 delete DTunnel 2>/dev/null
            echo "Painel removido!"
            sleep 2
            exit 0
            ;;
        6)
            echo -n "Digite a nova porta (ex: 3000, 80): "
            read new_port
            if [[ "$new_port" =~ ^[0-9]+$ ]]; then
                if [ ! -f "$ENV_FILE" ]; then
                    cp "$PANEL_DIR/.env.example" "$ENV_FILE"
                fi
                # Atualizar porta no .env
                sed -i "s/^PORT=.*/PORT=$new_port/" "$ENV_FILE"
                
                # Abrir porta no firewall se necessário
                if command -v ufw &> /dev/null; then
                    ufw allow $new_port/tcp
                elif command -v iptables &> /dev/null; then
                    iptables -I INPUT -p tcp --dport $new_port -j ACCEPT
                fi
                
                echo -e "${GREEN}Porta alterada para $new_port. Reiniciando painel...${NC}"
                cd "$PANEL_DIR"
                ./pon
            else
                echo -e "${RED}Porta inválida!${NC}"
            fi
            sleep 2
            ;;
        0)
            exit 0
            ;;
        *)
            echo -e "${RED}Opção inválida!${NC}"
            sleep 1
            ;;
    esac
done
