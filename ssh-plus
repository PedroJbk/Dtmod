#!/bin/bash
# ============================================================
# Script de Instalação - DTunnelMod
# Instala o painel automaticamente com todas as dependências
# ============================================================

# Cores para o terminal
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${GREEN}==============================================${NC}"
echo -e "${GREEN}    INSTALADOR AUTOMATICO - DTunnelMod        ${NC}"
echo -e "${GREEN}==============================================${NC}"
echo ""

# Detectar usuário atual e definir diretório de instalação
if [ "$(id -u)" -eq 0 ]; then
    INSTALL_DIR="/root/Dtmod"
    PANEL_USER="root"
else
    INSTALL_DIR="$HOME/Dtmod"
    PANEL_USER="$(whoami)"
fi

echo -e "${CYAN}[INFO]${NC} Usuario: $PANEL_USER"
echo -e "${CYAN}[INFO]${NC} Diretorio de instalacao: $INSTALL_DIR"
echo ""

# Atualizar sistema e instalar dependências básicas
echo -e "${CYAN}[1/8]${NC} Atualizando sistema e instalando dependencias..."
apt update -y
apt upgrade -y
apt install -y curl git wget build-essential ca-certificates gnupg

# Instalar Node.js 20.x se não existir
echo -e "${CYAN}[2/8]${NC} Verificando Node.js..."
if ! command -v node &> /dev/null; then
    echo "Instalando Node.js 20.x..."
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt install -y nodejs
else
    echo "Node.js ja esta instalado: $(node -v)"
fi

# Instalar PNPM se não existir
echo -e "${CYAN}[3/8]${NC} Verificando PNPM..."
if ! command -v pnpm &> /dev/null; then
    echo "Instalando PNPM..."
    npm install -g pnpm
else
    echo "PNPM ja esta instalado: $(pnpm -v)"
fi

# Instalar PM2 globalmente
echo -e "${CYAN}[4/8]${NC} Instalando PM2..."
npm install -g pm2

# Clonar ou atualizar o repositório
echo -e "${CYAN}[5/8]${NC} Preparando repositorio..."
if [ ! -d "$INSTALL_DIR" ]; then
    echo "Clonando repositorio para $INSTALL_DIR..."
    git clone https://github.com/PedroJbk/Dtmod.git "$INSTALL_DIR"
else
    echo "Repositorio ja existe em $INSTALL_DIR, atualizando..."
    cd "$INSTALL_DIR" && git pull
fi

cd "$INSTALL_DIR"

# Configurar .env
echo -e "${CYAN}[6/8]${NC} Configurando ambiente..."
if [ ! -f .env ]; then
    cp .env.example .env
    echo -e "${GREEN}.env criado com sucesso.${NC}"
else
    echo -e "${YELLOW}.env ja existe, mantendo configuracao atual.${NC}"
fi

# Instalar dependências do projeto
echo -e "${CYAN}[7/8]${NC} Instalando dependencias do projeto..."
pnpm install

# Gerar Prisma
echo -e "${CYAN}[8/8]${NC} Configurando banco de dados..."
npx prisma generate
npx prisma db push
npx prisma db seed

# Compilar o projeto
echo "Compilando projeto..."
npx tsc --build

# Configurar Firewall
PORT=$(grep "^PORT=" .env | cut -d'=' -f2 | tr -d ' ' || echo "3000")
if command -v ufw &> /dev/null; then
    ufw allow "$PORT"/tcp 2>/dev/null
    ufw reload 2>/dev/null
elif command -v iptables &> /dev/null; then
    iptables -I INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null
fi

# Iniciar com PM2
echo "Iniciando painel com PM2..."
pm2 delete DTunnel 2>/dev/null
pm2 start ecosystem.config.js
pm2 save
pm2 startup -u "$PANEL_USER" --hp "$HOME" 2>/dev/null

# Criar links simbólicos com caminhos absolutos para /usr/local/bin
echo "Criando atalhos globais..."
chmod +x "$INSTALL_DIR/menuop" "$INSTALL_DIR/pon" "$INSTALL_DIR/poff"
ln -sf "$INSTALL_DIR/menuop" /usr/local/bin/menuop
ln -sf "$INSTALL_DIR/pon" /usr/local/bin/pon
ln -sf "$INSTALL_DIR/poff" /usr/local/bin/poff

# Salvar o diretório de instalação para os scripts usarem
echo "$INSTALL_DIR" > "$INSTALL_DIR/.install_dir"

echo ""
echo -e "${GREEN}==============================================${NC}"
echo -e "${GREEN}  INSTALACAO CONCLUIDA COM SUCESSO!            ${NC}"
echo -e "${GREEN}==============================================${NC}"
echo ""
echo -e "${CYAN}Painel:${NC} http://$(curl -s https://api.ipify.org 2>/dev/null || echo 'SEU_IP'):$PORT"
echo -e "${CYAN}Usuario:${NC} Bk2026@12"
echo -e "${CYAN}Senha:${NC} 2012@bk2520"
echo ""
echo -e "${YELLOW}Comandos uteis:${NC}"
echo -e "  ${GREEN}menuop${NC}  - Gerenciar o painel"
echo -e "  ${GREEN}pon${NC}     - Iniciar painel"
echo -e "  ${GREEN}poff${NC}    - Parar painel"
echo ""
echo -e "${GREEN}==============================================${NC}"
