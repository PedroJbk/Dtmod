#!/bin/bash

# Atualizar sistema e instalar dependências básicas
apt update -y && apt upgrade -y
apt install -y curl git wget build-essential

# Instalar Node.js e PNPM se não existirem
if ! command -v node &> /dev/null; then
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt install -y nodejs
fi

if ! command -v pnpm &> /dev/null; then
    npm install -g pnpm
fi

# Instalar PM2 para gerenciar o processo
npm install -g pm2

# Configurar Firewall (Abrir porta 3000)
if command -v ufw &> /dev/null; then
    ufw allow 3000/tcp
    ufw reload
elif command -v iptables &> /dev/null; then
    iptables -I INPUT -p tcp --dport 3000 -j ACCEPT
fi

# Entrar na pasta do projeto (assume que já foi clonado ou está na pasta atual)
cd "$(dirname "$0")"

# Instalar dependências do projeto
pnpm install

# Gerar Prisma e Migrations
npx prisma db push
npx prisma db seed

# Compilar o projeto
npx tsc --build

# Iniciar com PM2
pm2 delete DTunnel 2>/dev/null
pm2 start ecosystem.config.js
pm2 save
pm2 startup

# Instalar comandos no sistema
ln -sf $(pwd)/pon /usr/local/bin/pon
ln -sf $(pwd)/poff /usr/local/bin/poff
ln -sf $(pwd)/menuop /usr/local/bin/menuop

echo "---------------------------------------------------"
echo "Instalação concluída!"
echo "Acesse: http://$(curl -s https://api.ipify.org):3000"
echo "Usuário: Bk2026@12"
echo "Senha: 2012@bk2520"
echo "---------------------------------------------------"
