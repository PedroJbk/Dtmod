#!/bin/bash
# ============================================================
# Script de Instalacao - DTunnelMod
# Instala o painel automaticamente com todas as dependencias
# ============================================================
# Cores para o terminal
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'
echo -e "${GREEN}==============================================${NC}"
echo -e "${GREEN}    INSTALADOR AUTOMATICO - DTunnelMod        ${NC}"
echo -e "${GREEN}==============================================${NC}"
echo ""
# Detectar usuario atual e definir diretorio de instalacao
if [ "$(id -u)" -eq 0 ]; then
    INSTALL_DIR="/root/Dtmod"
    PANEL_USER="root"
else
    INSTALL_DIR="$HOME/Dtmod"
    PANEL_USER="$(whoami)"
fi
echo -e "${CYAN}[INFO]${NC} Usuario: $PANEL_USER"
echo -e "${CYAN}[INFO]${NC} Diretorio de instalacao: $INSTALL_DIR"
echo ""
# Atualizar sistema e instalar dependencias basicas
echo -e "${CYAN}[1/9]${NC} Atualizando sistema e instalando dependencias..."
apt update -y && apt upgrade -y
apt install -y curl git wget build-essential ca-certificates gnupg
# Instalar Node.js 20.x se nao existir
echo -e "${CYAN}[2/9]${NC} Verificando Node.js..."
if ! command -v node &> /dev/null; then
    echo "Instalando Node.js 20.x..."
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt install -y nodejs
else
    echo "Node.js ja esta instalado: $(node -v)"
fi
# Instalar PNPM se nao existir
echo -e "${CYAN}[3/9]${NC} Verificando PNPM..."
if ! command -v pnpm &> /dev/null; then
    echo "Instalando PNPM..."
    npm install -g pnpm
else
    echo "PNPM ja esta instalado: $(pnpm -v)"
fi
# Instalar PM2 globalmente
echo -e "${CYAN}[4/9]${NC} Instalando PM2..."
npm install -g pm2
# Clonar ou atualizar o repositorio
echo -e "${CYAN}[5/9]${NC} Preparando repositorio..."
if [ -d "$INSTALL_DIR" ]; then
    echo "Repositorio ja existe em $INSTALL_DIR, atualizando..."
    cd "$INSTALL_DIR" || { echo -e "${RED}Erro: Falha ao acessar $INSTALL_DIR${NC}"; exit 1; }
    git fetch origin main
    git reset --hard origin/main
    git clean -fd
else
    echo "Clonando repositorio para $INSTALL_DIR..."
    git clone https://github.com/PedroJbk/Dtmod.git "$INSTALL_DIR" || { echo -e "${RED}Erro: Falha ao clonar repositorio${NC}"; exit 1; }
    cd "$INSTALL_DIR" || { echo -e "${RED}Erro: Falha ao acessar $INSTALL_DIR${NC}"; exit 1; }
fi
# Configurar .env
echo -e "${CYAN}[6/9]${NC} Configurando ambiente..."
if [ ! -f .env ]; then
    cp .env.example .env
    echo -e "${GREEN}.env criado com sucesso.${NC}"
else
    echo -e "${YELLOW}.env ja existe, mantendo configuracao atual.${NC}"
fi
# Limpar node_modules e reinstallar
echo -e "${CYAN}[7/9]${NC} Instalando dependencias do projeto..."
rm -rf node_modules
pnpm install --no-frozen-lockfile || { echo -e "${RED}Erro: Falha ao instalar dependencias${NC}"; exit 1; }
# Gerar Prisma Client + sincronizar banco de dados
echo -e "${CYAN}[8/9]${NC} Configurando banco de dados..."
npx prisma generate
npx prisma db push
npx prisma db seed
# Compilar o projeto (clean rebuild)
echo -e "${CYAN}[9/9]${NC} Compilando projeto..."
rm -rf build
npx tsc --build || { echo -e "${RED}Erro: Falha ao compilar projeto${NC}"; exit 1; }
# Configurar Firewall
PORT=$(grep "^PORT=" .env | cut -d'=' -f2 | tr -d ' ' || echo "3000")
if command -v ufw &> /dev/null; then
    ufw allow "$PORT"/tcp 2>/dev/null
    ufw reload 2>/dev/null
elif command -v iptables &> /dev/null; then
    iptables -I INPUT -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null
fi
# Parar PM2 existente
echo -e "${CYAN}Parando processos PM2 existentes...${NC}"
pm2 delete DTunnel 2>/dev/null
pm2 delete all 2>/dev/null
# Iniciar com PM2 usando cwd absoluto
echo "Iniciando painel com PM2..."
pm2 start ecosystem.config.js --cwd "$INSTALL_DIR" || { echo -e "${RED}Erro: Falha ao iniciar com PM2${NC}"; exit 1; }
pm2 save
pm2 startup -u "$PANEL_USER" --hp "$HOME" 2>/dev/null
# Criar links simbolicos com caminhos absolutos para /usr/local/bin
echo "Criando atalhos globais..."
chmod +x "$INSTALL_DIR/menuop" "$INSTALL_DIR/pon" "$INSTALL_DIR/poff"
ln -sf "$INSTALL_DIR/menuop" /usr/local/bin/menuop
ln -sf "$INSTALL_DIR/pon" /usr/local/bin/pon
ln -sf "$INSTALL_DIR/poff" /usr/local/bin/poff
# Salvar o diretorio de instalacao para os scripts usarem
echo "$INSTALL_DIR" > "$INSTALL_DIR/.install_dir"
echo ""
echo -e "${GREEN}==============================================${NC}"
echo -e "${GREEN}  INSTALACAO CONCLUIDA COM SUCESSO!            ${NC}"
echo -e "${GREEN}==============================================${NC}"
echo ""
echo -e "${CYAN}Painel:${NC} http://$(curl -s https://api.ipify.org 2>/dev/null || echo 'SEU_IP'):$PORT"
echo -e "${CYAN}Acesse o painel e faca login com suas credenciais configuradas.${NC}"
echo ""
echo -e "${YELLOW}Comandos uteis:${NC}"
echo -e "  ${GREEN}menuop${NC}  - Gerenciar o painel"
echo -e "  ${GREEN}pon${NC}     - Iniciar painel"
echo -e "  ${GREEN}poff${NC}    - Parar painel"
echo ""
echo -e "${GREEN}==============================================${NC}"
